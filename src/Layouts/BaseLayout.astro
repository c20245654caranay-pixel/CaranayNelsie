---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
const name = "CaranayNelsie";
const position = "Developer";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			const prefersDark = window.matchMedia(
				"(prefers-color-scheme: dark)",
			).matches;
			let savedTheme = null;

			try {
				savedTheme = localStorage.getItem("theme");
			} catch (error) {
				console.error("Could not read the saved theme preference.", error);
			}

			if (savedTheme === "dark" || (savedTheme !== "light" && prefersDark)) {
				document.documentElement.classList.add("dark");
			}
		</script>
		<title>{name} {position}</title>
	</head>
	<body class="min-h-screen bg-white text-slate-900 transition-colors dark:bg-slate-900 dark:text-slate-100">
		<div
			id="pageScrollProgress"
			role="progressbar"
			aria-label="Page scroll progress"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="0"
			class="fixed inset-x-0 top-0 z-50 h-1 bg-purple-200/70 dark:bg-slate-700/70"
		>
			<div
				id="pageScrollProgressFill"
				class="h-full origin-left bg-purple-600 dark:bg-purple-400"
				style="transform: scaleX(0)"
			></div>
		</div>
		<Header />
		<slot />
		<Footer />
		<script>
			const pageScrollProgress = document.getElementById("pageScrollProgress");
			const pageScrollProgressFill = document.getElementById(
				"pageScrollProgressFill",
			);

			const updateScrollProgress = () => {
				const scrollableHeight =
					document.documentElement.scrollHeight - window.innerHeight;
				const progress =
					scrollableHeight > 0
						? Math.min(Math.max(window.scrollY / scrollableHeight, 0), 1)
						: 0;

				if (pageScrollProgressFill) {
					pageScrollProgressFill.style.transform = `scaleX(${progress})`;
				}
				pageScrollProgress?.setAttribute(
					"aria-valuenow",
					String(Math.round(progress * 100)),
				);
			};

			updateScrollProgress();
			window.addEventListener("scroll", updateScrollProgress, { passive: true });
			window.addEventListener("resize", updateScrollProgress);

			const themeToggle = document.getElementById("themeToggle");
			const themeToggleLabel = document.getElementById("themeToggleLabel");
			const themeToggleIcon = document.getElementById("themeToggleIcon");

			if (themeToggle) {
				const syncThemeToggle = () => {
					const isDark = document.documentElement.classList.contains("dark");
					if (themeToggleLabel) {
						themeToggleLabel.textContent = isDark ? "Light mode" : "Dark mode";
					}
					if (themeToggleIcon) {
						themeToggleIcon.textContent = isDark ? "☀️" : "🌙";
					}
					themeToggle.setAttribute(
						"aria-label",
						`Switch theme. Current mode: ${isDark ? "dark" : "light"}`,
					);
					themeToggle.setAttribute("aria-pressed", String(isDark));
				};

				syncThemeToggle();
				themeToggle.addEventListener("click", () => {
					const isDark = document.documentElement.classList.toggle("dark");
					syncThemeToggle();

					try {
						localStorage.setItem("theme", isDark ? "dark" : "light");
					} catch (error) {
						console.error("Could not save the theme preference.", error);
					}
				});
			}
		</script>
		<script>
            import { FallingLeaves } from "falling-leaves";

            new FallingLeaves({ shapes: ["maple", "oak", "ginkgo", "birch", "oval"] });
        </script>
	</body>
    
</html>