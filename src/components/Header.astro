<header class="flex flex-wrap items-center justify-between gap-4 border-b border-purple-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
    <h1 class="text-2xl font-bold text-purple-700 dark:text-purple-300">
        Nelsie Caranay
    </h1>

    <div class="flex flex-wrap items-center gap-5">
    <nav>
        <ul class="flex flex-wrap gap-5">
            <li><a href="#projects" class="hover:text-purple-500">Projects</a></li>
            <li><a href="#coffee" class="hover:text-purple-500">Coffee Shop</a></li>
            <li><a href="#coffeeDemoCard" class="hover:text-purple-500">GSAP Demo</a></li>
            <li><a href="#contact" class="hover:text-purple-500">Contact</a></li>
