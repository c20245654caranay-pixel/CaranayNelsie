    <button
        id="themeToggle"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
        class="inline-flex items-center gap-2 rounded-lg border border-purple-300 px-4 py-2 text-sm font-medium text-purple-800 transition-colors hover:bg-purple-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:border-slate-600 dark:text-purple-200 dark:hover:bg-slate-800"
    >
        <span id="themeToggleIcon" aria-hidden="true">🌙</span>
        <span id="themeToggleLabel">Dark mode</span>
    </button>
    </div>
