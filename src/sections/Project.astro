---
---

<section id="coffee" class="px-5 py-16 bg-purple-50 dark:bg-slate-950">

    <div class="max-w-5xl mx-auto">

        <h2 class="text-3xl font-bold text-purple-800 dark:text-purple-300 text-center">
            My Coffee Shop Project
        </h2>

        <p class="text-center text-gray-600 dark:text-gray-400 mt-3 mb-5">
            Scroll through this section to scrub the product animation.
        </p>

        <div id="coffeeDemoCard"
            class="max-w-md mx-auto p-6 rounded-2xl bg-white dark:bg-slate-900 shadow-lg border border-purple-200 dark:border-slate-700">

            <div class="flex justify-between items-center">
                <span id="demoStockStatus"
                    class="text-xs font-bold text-emerald-600 bg-emerald-100 px-3 py-2 rounded-full">
                    IN STOCK
                </span>

                <span class="text-sm text-purple-500">
                    Stock: <span id="demoStock">48</span> pcs
                </span>
            </div>

            <div id="coffeeCup" class="text-7xl text-center my-6">
                ☕
            </div>

            <h3 id="coffeeName"
                class="text-xl font-bold text-purple-800 dark:text-purple-300 text-center">
                3-in-1 Coffee Sachet
            </h3>

            <p class="text-sm text-center text-gray-500 mt-2">
                Original Flavor (28g)
            </p>

            <p id="coffeePrice"
                class="text-3xl font-black text-purple-600 dark:text-purple-400 text-center my-5">
                ₱10.00
            </p>

            <button id="coffeeDemoButton"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-xl">
                + Add Coffee to Cart
            </button>

            <p class="text-center text-sm mt-4 text-gray-500 dark:text-gray-400">
                Cart Quantity:
                <span id="demoCartQuantity">0</span>
            </p>

            <p id="coffeeDemoMessage" class="text-center text-sm mt-3"></p>

        </div>

        <div class="flex flex-wrap justify-center gap-3 mt-7">

            <button id="coffeeAnimation"
                class="bg-pink-600 text-white px-4 py-3 rounded-xl">
                Animate Coffee
            </button>

            <button id="coffeePriceAnimation"
                class="bg-violet-600 text-white px-4 py-3 rounded-xl">
                Animate Price
            </button>

            <button id="coffeeReplay"
                class="bg-slate-800 text-white px-4 py-3 rounded-xl">
                ↻ Replay All
            </button>

        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">

            <article class="demo-card p-5 rounded-xl bg-white dark:bg-slate-900 border border-purple-300">
                <h3 class="font-bold text-purple-600">1. Scroll Scrub</h3>
                <p class="text-sm mt-2 text-gray-500">Control the product animation by scrolling.</p>
                <button data-demo="scrub" class="demo-button mt-4 w-full border border-purple-500 rounded-lg p-2">View Demo</button>
            </article>

            <article class="demo-card p-5 rounded-xl bg-white dark:bg-slate-900 border border-violet-300">
                <h3 class="font-bold text-violet-600">2. Text Animation</h3>
                <p class="text-sm mt-2 text-gray-500">Animate the coffee product name.</p>
                <button data-demo="text" class="demo-button mt-4 w-full border border-violet-500 rounded-lg p-2">View Demo</button>
            </article>

            <article class="demo-card p-5 rounded-xl bg-white dark:bg-slate-900 border border-pink-300">
                <h3 class="font-bold text-pink-600">3. Product Bounce</h3>
                <p class="text-sm mt-2 text-gray-500">Make the coffee cup bounce.</p>
                <button data-demo="bounce" class="demo-button mt-4 w-full border border-pink-500 rounded-lg p-2">View Demo</button>
            </article>

            <article class="demo-card p-5 rounded-xl bg-white dark:bg-slate-900 border border-emerald-300">
                <h3 class="font-bold text-emerald-600">4. Price Animation</h3>
                <p class="text-sm mt-2 text-gray-500">Highlight the coffee price.</p>
                <button data-demo="price" class="demo-button mt-4 w-full border border-emerald-500 rounded-lg p-2">View Demo</button>
            </article>

            <article class="demo-card p-5 rounded-xl bg-white dark:bg-slate-900 border border-orange-300">
                <h3 class="font-bold text-orange-600">5. Button Feedback</h3>
                <p class="text-sm mt-2 text-gray-500">Animate the Add to Cart button.</p>
                <button data-demo="button" class="demo-button mt-4 w-full border border-orange-500 rounded-lg p-2">View Demo</button>
            </article>

            <article class="demo-card p-5 rounded-xl bg-white dark:bg-slate-900 border border-cyan-300">
                <h3 class="font-bold text-cyan-600">6. Card Entrance</h3>
                <p class="text-sm mt-2 text-gray-500">Slide the product card into view.</p>
                <button data-demo="card" class="demo-button mt-4 w-full border border-cyan-500 rounded-lg p-2">View Demo</button>
            </article>

        </div>

        <div class="text-center mt-7">
            <button id="replayDemos"
                class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-xl">
                ↻ Replay All GSAP Demos
            </button>

            <p id="demoMessage" class="text-sm text-purple-600 dark:text-purple-300 mt-4">
                Choose a demo to see the coffee animations.
            </p>
        </div>

    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;
    const productCard = document.querySelector<HTMLElement>("#coffeeDemoCard");
    const coffeeCup = document.querySelector<HTMLElement>("#coffeeCup");
    const coffeeName = document.querySelector<HTMLElement>("#coffeeName");
    const coffeePrice = document.querySelector<HTMLElement>("#coffeePrice");
    const addToCartButton =
        document.querySelector<HTMLButtonElement>("#coffeeDemoButton");
    const demoMessage = document.querySelector<HTMLElement>("#demoMessage");
    const coffeeSection = document.querySelector<HTMLElement>("#coffee");
    if (!prefersReducedMotion && coffeeSection) {
        const scrubTimeline = gsap.timeline({
            scrollTrigger: {
                trigger: coffeeSection,
                start: "top 75%",
                end: "bottom 25%",
                scrub: 0.6,
            },
        });

        if (productCard) {
            scrubTimeline.fromTo(
                productCard,
                { y: 72, scale: 0.9 },
                { y: 0, scale: 1, ease: "none" },
                0,
            );
        }
        if (coffeeCup) {
            scrubTimeline.fromTo(
                coffeeCup,
                { y: 28, rotation: -12, scale: 0.85 },
                { y: -28, rotation: 12, scale: 1.08, ease: "none" },
                0,
            );
        }
        if (coffeeName) {
            scrubTimeline.fromTo(
                coffeeName,
                { x: -32, autoAlpha: 0.55 },
                { x: 0, autoAlpha: 1, ease: "none" },
                0,
            );
        }
        if (coffeePrice) {
            scrubTimeline.fromTo(
                coffeePrice,
                { x: 32, autoAlpha: 0.55 },
                { x: 0, autoAlpha: 1, ease: "none" },
                0,
            );
        }
    }

    if (!prefersReducedMotion) {
        document.querySelectorAll<HTMLElement>(".demo-card").forEach((card) => {
            gsap.fromTo(
                card,
                { autoAlpha: 0, y: 24 },
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.6,
                    ease: "power2.out",
                    scrollTrigger: { trigger: card, start: "top 90%", once: true },
                },
            );
        });
    }

    const playDemo = (demo: string) => {
        if (prefersReducedMotion) {
            if (demoMessage) {
                demoMessage.textContent =
                    "Animations are disabled because reduced motion is enabled.";
            }
            return;
        }

        switch (demo) {
            case "scrub":
                coffeeSection?.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
                if (demoMessage) {
                    demoMessage.textContent =
                        "Scroll through the coffee section to control the animation.";
                }
                break;
            case "scroll":
                if (productCard) {
                    gsap.fromTo(
                        productCard,
                        { autoAlpha: 0, y: 36 },
                        {
                            autoAlpha: 1,
                            y: 0,
                            duration: 0.8,
                            ease: "power2.out",
                            scrollTrigger: {
                                trigger: productCard,
                                start: "top 80%",
                                once: true,
                            },
                        },
                    );
                    productCard.scrollIntoView({
                        behavior: "smooth",
                        block: "center",
                    });
                }
                break;
            case "text":
                if (coffeeName) {
                    gsap.fromTo(
                        coffeeName,
                        { autoAlpha: 0, y: 20 },
                        { autoAlpha: 1, y: 0, duration: 0.7, ease: "back.out(1.7)" },
                    );
                }
                break;
            case "bounce":
                if (coffeeCup) {
                    gsap.fromTo(
                        coffeeCup,
                        { y: -36, scale: 0.85 },
                        { y: 0, scale: 1, duration: 0.9, ease: "bounce.out" },
                    );
                }
                break;
            case "price":
                if (coffeePrice) {
                    gsap.fromTo(
                        coffeePrice,
                        { scale: 0.8, color: "#ec4899" },
                        {
                            scale: 1,
                            color: "#9333ea",
                            duration: 0.7,
                            ease: "elastic.out(1, 0.4)",
                        },
                    );
                }
                break;
            case "button":
                if (addToCartButton) {
                    gsap.fromTo(
                        addToCartButton,
                        { scale: 0.94 },
                        { scale: 1, duration: 0.45, ease: "elastic.out(1, 0.4)" },
                    );
                }
                break;
            case "card":
                if (productCard) {
                    gsap.fromTo(
                        productCard,
                        { autoAlpha: 0, x: -48 },
                        { autoAlpha: 1, x: 0, duration: 0.7, ease: "power2.out" },
                    );
                }
                break;
        }

        if (demoMessage) {
            demoMessage.textContent = `Playing ${demo} animation.`;
        }
    };

    document.querySelectorAll<HTMLButtonElement>(".demo-button").forEach((button) => {
        button.addEventListener("click", () => {
            const demo = button.dataset.demo;
            if (demo) playDemo(demo);
        });
    });

    document
        .querySelector<HTMLButtonElement>("#coffeeAnimation")
        ?.addEventListener("click", () => playDemo("bounce"));
    document
        .querySelector<HTMLButtonElement>("#coffeePriceAnimation")
        ?.addEventListener("click", () => playDemo("price"));

    const replayAnimations = () => {
        if (prefersReducedMotion) {
            playDemo("replay");
            return;
        }

        const timeline = gsap.timeline();
        if (productCard) {
            timeline.fromTo(
                productCard,
                { autoAlpha: 0, y: 30 },
                { autoAlpha: 1, y: 0, duration: 0.65, ease: "power2.out" },
            );
        }
        if (coffeeCup) {
            timeline.fromTo(
                coffeeCup,
                { y: -32, scale: 0.85 },
                { y: 0, scale: 1, duration: 0.8, ease: "bounce.out" },
                "-=0.2",
            );
        }
        if (coffeeName) {
            timeline.fromTo(
                coffeeName,
                { autoAlpha: 0, y: 16 },
                { autoAlpha: 1, y: 0, duration: 0.5, ease: "power2.out" },
                "-=0.35",
            );
        }
        if (coffeePrice) {
            timeline.fromTo(
                coffeePrice,
                { scale: 0.85 },
                { scale: 1, duration: 0.45, ease: "back.out(2)" },
                "-=0.2",
            );
        }
        if (addToCartButton) {
            timeline.fromTo(
                addToCartButton,
                { scale: 0.96 },
                { scale: 1, duration: 0.4, ease: "back.out(2)" },
                "-=0.2",
            );
        }

        if (demoMessage) demoMessage.textContent = "Playing all animations.";
    };

    document
        .querySelector<HTMLButtonElement>("#coffeeReplay")
        ?.addEventListener("click", replayAnimations);
    document
        .querySelector<HTMLButtonElement>("#replayDemos")
        ?.addEventListener("click", replayAnimations);
</script>